{
  "name": "everpeace",
  "version": "0.2.4",
  "description": "A sandboxed terminal ReAct agent with persistent sessions, MCP, skills, and web access.",
  "type": "module",
  "bin": {
    "everpeace": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "third_party/codex",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "start": "node dist/cli/index.js",
    "test": "tsx --test tests/**/*.test.{ts,tsx}",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.22.0",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^2.1.0",
    "@openai/codex": "0.155.1",
    "@xterm/headless": "^6.0.0",
    "fflate": "^0.8.2",
    "ink": "^7.1.1",
    "jsonc-parser": "^3.3.1",
    "lowlight": "^3.3.0",
    "marked": "^18.0.13",
    "node-pty": "^1.1.0",
    "openai": "^7.15.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
