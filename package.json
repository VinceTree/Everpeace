{
  "name": "everpeace",
  "version": "0.6.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.30.3",
  "bin": {
    "everpeace": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "tsx --test --test-concurrency=4 tests/**/*.test.{ts,tsx}",
    "build": "tsc -p tsconfig.build.json",
    "install:verify": "node scripts/verify-source-install.mjs",
    "install:smoke": "node scripts/source-install-smoke.mjs",
    "install:clean": "node scripts/verify-clean-install.mjs",
    "benchmark": "tsx src/benchmark/campaign-cli.ts",
    "test:security": "node --import tsx --test tests/unit/security/*.test.ts",
    "prove:web": "tsx tests/fixtures/prove-web-content.ts",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "node scripts/release/require-bundle.mjs",
    "pack:release": "node scripts/release/pack.mjs",
    "install:consumer": "node scripts/release/consumer-install.mjs",
    "native:verify": "node scripts/release/native-verify.mjs",
    "ci:verify": "node scripts/release/check-workflows.mjs",
    "security:scan": "node scripts/security/scan.mjs",
    "benchmark:campaign": "tsx src/benchmark/campaign-cli.ts",
    "benchmark:prove-expanded": "tsx tests/fixtures/prove-expanded.ts",
    "benchmark:optimization": "tsx scripts/benchmark/run-optimization.ts",
    "benchmark:memory": "tsx scripts/benchmark/evaluate-memory.ts"
  },
  "dependencies": {
    "@inkjs/ui": "2.0.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@napi-rs/keyring": "2.1.0",
    "@openai/codex": "0.162.0",
    "@vscode/ripgrep": "1.18.0",
    "@xterm/headless": "6.0.0",
    "css-select": "7.0.0",
    "domutils": "4.0.2",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "ink": "8.0.0",
    "jsonc-parser": "3.3.1",
    "lowlight": "3.3.0",
    "marked": "18.0.13",
    "node-pty": "1.1.0",
    "openai": "7.15.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "undici": "7.30.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "fast-check": "4.10.2",
    "ink-testing-library": "4.0.0",
    "oxlint": "1.87.0",
    "react-test-renderer": "19.3.0",
    "spdx-expression-parse": "5.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "typescript-evaluator": "npm:typescript@5.9.3"
  },
  "description": "A sandboxed terminal ReAct agent with persistent sessions, MCP, skills, and web access.",
  "files": [
    "dist",
    "assets",
    "third_party/codex",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "bundleDependencies": [
    "node-pty"
  ]
}
