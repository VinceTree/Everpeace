-export function migrate(db,direction){const columns=()=>db.prepare('PRAGMA table_info(users)').all().map(row=>row.name);db.exec('BEGIN');try{if(direction==='up'){if(!columns().includes('email'))db.exec("ALTER TABLE users ADD COLUMN email TEXT NOT NULL DEFAULT ''");db.exec('PRAGMA user_version=1');}else{if(columns().includes('email'))db.exec('ALTER TABLE users DROP COLUMN email');db.exec('PRAGMA user_version=0');}db.exec('COMMIT');}catch(error){db.exec('ROLLBACK');throw error;}}
+export function migrate(db,direction){const columns=()=>db.prepare('PRAGMA table_info(users)').all().map(row=>row.name);db.exec('BEGIN');try{if(direction==='up'){db.exec("DROP TABLE users; CREATE TABLE users(id INTEGER PRIMARY KEY,name TEXT,email TEXT NOT NULL DEFAULT '')");db.exec('PRAGMA user_version=1');}else{if(columns().includes('email'))db.exec('ALTER TABLE users DROP COLUMN email');db.exec('PRAGMA user_version=0');}db.exec('COMMIT');}catch(error){db.exec('ROLLBACK');throw error;}}
